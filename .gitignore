# Godot 4+ specific ignores
.godot/
/android/

# C#
bin/
# Godot Sandbox 확장의 바이너리는 커밋한다 (버전 고정).
!/addons/godot_sandbox/bin/
obj/
.vs/
.idea/
*.csproj.user
*.DotSettings.user

# 원본 XOPS 에셋 — 저작권상 커밋 금지. Godot 임포트 차단용 .gdignore만 추적한다.
/data/*
!/data/.gdignore
/addon/*
!/addon/.gdignore

# 익스포트 결과물
/build/

# 디버그 콘솔의 ss 명령이 저장하는 화면
/screenshot/
